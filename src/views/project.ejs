<%- include('partials/header') %>

  <main id="main-content">
    <div class="page-content">
      <div class="container">

        <div class="page-header">
          <p class="page-label">Project Details</p>
          <h1>
            <%= projectDetails.title %>
          </h1>
        </div>

        <div class="project-detail">
          <p>
            <%= projectDetails.description %>
          </p>
          <p><strong>Start Date:</strong>
            <%= projectDetails.project_date.toDateString() %>
          </p>

          <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>">
              <%= projectDetails.organization_name %>
            </a></p>
          <p><strong>Location:</strong>
            <%= projectDetails.location %>
          </p>

          <% if (categories && categories.length> 0) { %>
            <ul class="category-tags" role="list">
              <% categories.forEach(function(cat) { %>
                <li class="category-tag">
                  <a href="/category/<%= cat.category_id %>">
                    <%= cat.name %>
                  </a>
                </li>
                <% }); %>
            </ul>
            <% } %>

        </div>
      </div>
  </main>

  <%- include('partials/footer') %>