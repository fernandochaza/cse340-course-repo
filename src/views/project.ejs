<%- include('partials/header') %>

  <main id="main-content">
    <div class="page-content">
      <div class="container">

        <div class="page-header">
          <p class="page-label">Project Details</p>
          <h1>
            <%= projectDetails.title %>
          </h1>
          <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-project/<%= projectDetails.service_project_id %>" class="btn btn-secondary">Edit</a>
            <a href="/project/<%= projectDetails.service_project_id %>/assign-categories"
              class="btn btn-secondary">Assign Categories</a>
            <% } %>
        </div>

        <div class="project-detail">
          <p>
            <%= projectDetails.description %>
          </p>
          <p><strong>Start Date:</strong>
            <%= projectDetails.project_date.toDateString() %>
          </p>

          <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>">
              <%= projectDetails.organization_name %>
            </a></p>
          <p><strong>Location:</strong>
            <%= projectDetails.location %>
          </p>

          <% if (categories && categories.length> 0) { %>
            <ul class="category-tags" role="list">
              <% categories.forEach(function(cat) { %>
                <li class="category-tag">
                  <a href="/category/<%= cat.category_id %>">
                    <%= cat.name %>
                  </a>
                </li>
                <% }); %>
            </ul>
            <% } %>

              <% if (user) { %>
                <div class="volunteer-section">
                  <% if (volunteering) { %>
                    <p><strong>You are volunteering for this project.</strong></p>
                    <form action="/project/<%= projectDetails.service_project_id %>/unvolunteer" method="POST">
                      <button type="submit" class="btn btn-secondary">Remove myself as a volunteer</button>
                    </form>
                    <% } else { %>
                      <form action="/project/<%= projectDetails.service_project_id %>/volunteer" method="POST">
                        <button type="submit" class="btn btn-primary">Volunteer for this project</button>
                      </form>
                      <% } %>
                </div>
                <% } %>

        </div>
      </div>
  </main>

  <%- include('partials/footer') %>