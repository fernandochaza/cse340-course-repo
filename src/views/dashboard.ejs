<%- include('partials/header') %>

  <main id="main-content">
    <section class="page-content">
      <div class="container">
        <h1>Dashboard</h1>
        <p>Name: <%= name %>
        </p>
        <p>Email: <%= email %>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
          <p><a href="/users" class="btn btn-primary">Manage Users</a></p>
          <% } %>

            <h2>My Volunteer Projects</h2>
            <% if (volunteerProjects.length===0) { %>
              <p>You have not signed up to volunteer for any projects yet.</p>
              <% } else { %>
                <ul>
                  <% volunteerProjects.forEach(function(project) { %>
                    <li>
                      <a href="/project/<%= project.service_project_id %>">
                        <%= project.title %>
                      </a>
                      - <%= project.project_date.toDateString() %>
                        <form action="/project/<%= project.service_project_id %>/unvolunteer" method="POST"
                          style="display:inline;">
                          <button type="submit" class="btn btn-secondary">Remove</button>
                        </form>
                    </li>
                    <% }); %>
                </ul>
                <% } %>

      </div>
    </section>
  </main>

  <%- include('partials/footer') %>