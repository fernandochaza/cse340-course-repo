<%- include('partials/header') %>

  <main id="main-content">
    <div class="page-content">
      <div class="container">
        <div class="page-header">
          <h1>
            <%= title %>
          </h1>
          <p>Upcoming service projects you can join:</p>
        </div>

        <ul class="projects-list" role="list">
          <% projects.forEach(function(project) { %>
            <li class="card project-card">
              <a href="/project/<%= project.service_project_id %>" class="card-link">
                <h3>
                  <%= project.title %>
                </h3>
                <p><strong>Organization:</strong>
                  <%= project.organization_name %>
                </p>
                <p><strong>Description:</strong>
                  <%= project.description %>
                </p>
                <p><strong>Location:</strong>
                  <%= project.location %>
                </p>
                <p><strong>Date:</strong>
                  <%= new Date(project.project_date).toLocaleDateString() %>
                </p>
                <span class="card-cta">View details &rarr;</span>
              </a>
            </li>
            <% }); %>

        </ul>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>