<%- include('partials/header') %>
  <main id="main-content">
    <div class="page-content">
      <div class="container">
        <div class="page-header">
          <h1>
            <%= title %>
          </h1>
          <p>Fill out the form below to add a new service project.</p>
        </div>

        <form action="/new-project" method="POST" class="card form-card">
          <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" maxlength="200" required />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="1000" required></textarea>
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" maxlength="200" required />
          </div>

          <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" required />
          </div>

          <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
              <option value="">-- Select an Organization --</option>
              <% organizations.forEach(function(org) { %>
                <option value="<%= org.organization_id %>">
                  <%= org.name %>
                </option>
                <% }); %>
            </select>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Project</button>
            <a href="/projects" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>