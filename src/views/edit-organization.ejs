<%- include('partials/header') %>
  <main id="main-content">
    <div class="page-content">
      <div class="container">
        <div class="page-header">
          <h1>
            <%= title %>
          </h1>
          <p>Update the details for this organization.</p>
        </div>

        <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST"
          class="card form-card">
          <div class="form-group">
            <label for="name">Organization Name</label>
            <input type="text" id="name" name="name" value="<%= organizationDetails.name %>" />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description"><%= organizationDetails.description %></textarea>
          </div>

          <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input type="email" id="contactEmail" name="contactEmail"
              value="<%= organizationDetails.contact_email %>" />
          </div>

          <div class="form-group">
            <label for="logoFilename">Logo Filename</label>
            <input type="text" id="logoFilename" name="logoFilename" value="<%= organizationDetails.logo_filename %>" />
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Organization</button>
            <a href="/organization/<%= organizationDetails.organization_id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>