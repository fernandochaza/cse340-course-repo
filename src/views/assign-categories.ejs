<%- include('partials/header') %>
  <main id="main-content">
    <div class="page-content">
      <div class="container">
        <div class="page-header">
          <h1>
            <%= title %>
          </h1>
          <p>Project: <strong>
              <%= projectDetails.title %>
            </strong></p>
        </div>

        <form action="/project/<%= projectDetails.service_project_id %>/assign-categories" method="POST"
          class="card form-card">
          <div class="form-group">
            <% allCategories.forEach(function(category) { %>
              <% const isAssigned=assignedCategories.some(function(a) { return a.category_id===category.category_id; });
                %>
                <label class="checkbox-label">
                  <input type="checkbox" name="categoryIds" value="<%= category.category_id %>" <%=isAssigned
                    ? 'checked' : '' %>
                  />
                  <%= category.name %>
                </label>
                <% }); %>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Categories</button>
            <a href="/project/<%= projectDetails.service_project_id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>