<%- include('partials/header') %>
  <main id="main-content">
    <div class="page-content">
      <div class="container">
        <div class="page-header">
          <h1>
            <%= title %>
          </h1>
          <p>Update the details for this service project.</p>
        </div>

        <form action="/edit-project/<%= projectDetails.service_project_id %>" method="POST" class="card form-card">
          <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" maxlength="200" required value="<%= projectDetails.title %>" />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="1000"
              required><%= projectDetails.description %></textarea>
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" maxlength="200" required
              value="<%= projectDetails.location %>" />
          </div>

          <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" required
              value="<%= projectDetails.project_date.toISOString().split('T')[0] %>" />
          </div>

          <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
              <option value="">-- Select an Organization --</option>
              <% organizations.forEach(function(org) { %>
                <option value="<%= org.organization_id %>" <%=org.organization_id===projectDetails.organization_id
                  ? 'selected' : '' %>>
                  <%= org.name %>
                </option>
                <% }); %>
            </select>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Project</button>
            <a href="/project/<%= projectDetails.service_project_id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>